<?xml version="1.0"?>
<!-- Mesh-based example arm for tests and CI. Meshes come from ../../make_meshes.py; nothing here is a
     real robot. Y is up (as in many CAD exports), so twin.yaml sets up_axis: "+y".
     Mesh references: package:// (base, upper arm) and a path relative to this file (forearm).
     Inertials are those of simple solids of about the same size. -->
<robot name="mesh_arm">
  <material name="grey"><color rgba="0.6 0.6 0.65 1"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0.05 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.0173" ixy="0" ixz="0" iyy="0.0173" iyz="0" izz="0.0173"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://mesh_arm_description/meshes/base.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://mesh_arm_description/meshes/base.stl"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.15 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="12" velocity="1.5"/>
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0 0.15 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0078" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0078"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://mesh_arm_description/meshes/upper_arm.stl"/></geometry>
      <material name="orange"><color rgba="0.9 0.5 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><mesh filename="package://mesh_arm_description/meshes/upper_arm.stl"/></geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0.3 0" rpy="0 0 0.3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.2" upper="2.2" effort="8" velocity="2.0"/>
  </joint>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0 0.125 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0027"/>
    </inertial>
    <visual>
      <geometry><mesh filename="../meshes/forearm.obj" scale="1 1 1"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><mesh filename="../meshes/forearm.obj"/></geometry>
    </collision>
  </link>

  <joint name="wrist_joint" type="continuous">
    <parent link="forearm_link"/>
    <child link="hand_link"/>
    <origin xyz="0 0.25 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2" velocity="4.0"/>
  </joint>

  <link name="hand_link">
    <inertial>
      <origin xyz="0 0.03 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0.03 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.035" length="0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0.03 0"/>
      <geometry><sphere radius="0.035"/></geometry>
    </collision>
  </link>

  <joint name="gripper_joint" type="prismatic">
    <parent link="hand_link"/>
    <child link="finger_link"/>
    <origin xyz="0 0.06 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.02" effort="5" velocity="0.05"/>
  </joint>

  <link name="finger_link">
    <inertial>
      <origin xyz="0 0.02 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000005"/>
    </inertial>
    <visual>
      <origin xyz="0 0.02 0"/>
      <geometry><box size="0.01 0.04 0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0.02 0"/>
      <geometry><box size="0.01 0.04 0.02"/></geometry>
    </collision>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="hand_link"/>
    <child link="tool_frame"/>
    <origin xyz="0 0.1 0"/>
  </joint>

  <link name="tool_frame"/>
</robot>
